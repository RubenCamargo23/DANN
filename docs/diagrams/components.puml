@startuml components
title Vista funcional - Modelo de componentes

actor "Cliente (Postman)" as client

package "Sistema de envíos colaborativos" {
  [users_app] as users
  [routes_app] as routes
  [posts_app] as posts
  [offers_app] as offers
}

database "users_db" as usersdb
database "routes_db" as routesdb
database "posts_db" as postsdb
database "offers_db" as offersdb

client --> users : HTTP REST /users
client --> routes : HTTP REST /routes
client --> posts : HTTP REST /posts
client --> offers : HTTP REST /offers

users --> usersdb
routes --> routesdb
posts --> postsdb
offers --> offersdb

note bottom of posts
  En esta entrega los
  componentes están
  desacoplados: no hay
  comunicación entre ellos.
end note

@enduml
