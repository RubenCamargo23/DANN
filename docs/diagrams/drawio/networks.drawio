          <mxGeometry x="330" y="140" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rd" value="routes-db" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
