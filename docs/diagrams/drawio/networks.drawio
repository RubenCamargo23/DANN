        <!-- Red posts -->
        <mxCell id="netposts" value="Red posts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="100" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="posts-app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="140" height="40" as="geometry" />
