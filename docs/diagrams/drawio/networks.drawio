        <mxCell id="e-ext-ua" value="NodePort 30001" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="ext" target="ua">
