        <mxCell id="ud" value="users-db" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="210" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e-ua-ud" value="NetworkPolicy&#10;allow 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="ua" target="ud">
